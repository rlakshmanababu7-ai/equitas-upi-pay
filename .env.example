# ==============================================================================
# EMI UPI Payment Link Application - Environment Variables
# ==============================================================================

# Database Connection
# SQLite for local development: "file:./dev.db"
# PostgreSQL for Vercel / Neon / Supabase / AWS: "postgresql://user:pass@host:5432/dbname?sslmode=require"
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# Business UPI Receiving Configuration (SERVER-SIDE ONLY - NEVER EXPOSED CLIENT-SIDE)
# ------------------------------------------------------------------------------
# The receiving business UPI VPA. All customer payments will be directed to this ID.
# The customer UPI ID entered on the staff portal is for internal records only.
MERCHANT_UPI_ID="apexfinserve.emi@icici"

# Registered legal business name displayed in UPI apps upon scanning / opening intent
MERCHANT_NAME="Apex FinServe Lending Ltd"

# Merchant Category Code (MCC). 6012 is standard for Loan / Financial Institutions
MERCHANT_CODE="6012"

# Public Application Base URL (used for generating absolute payment URLs)
# In production on Vercel, set to: https://your-app.vercel.app
APP_BASE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# Security & Session Authentication
# ------------------------------------------------------------------------------
# Strong 32+ character secret used to sign and encrypt staff session tokens
SESSION_SECRET="replace-with-a-random-32-byte-hex-string-for-production"

# Webhook secret to verify cryptographic signatures of incoming payment provider notifications
WEBHOOK_SECRET="replace-with-webhook-signing-secret"

# ------------------------------------------------------------------------------
# Initial Staff Seed Credentials (used by `npm run db:seed`)
# ------------------------------------------------------------------------------
STAFF_DEFAULT_USERNAME="officer@apexfinserve.com"
STAFF_DEFAULT_PASSWORD="ApexStaff2025!Secure"
STAFF_DEFAULT_NAME="Loan Operations Officer"
